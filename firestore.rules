rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Users can read/write their own document only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sellers: Anyone can read public seller profiles; only owner seller can update shop details
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'qualityScore', 'commissionRate']);
    }

    // Products: Anyone can read active products; sellers can manage their own products
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Orders: Customers and involved Sellers can read/update their orders
    match /orders/{orderId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Customization Requests & Messages
    match /customizationRequests/{requestId} {
      allow read, create, update: if request.auth != null;
    }

    match /messages/{conversationId}/messages/{messageId} {
      allow read, create: if request.auth != null;
    }

    // Wishlists & Followers
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /followers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Returns & Complaints
    match /returns/{returnId} {
      allow read, create, update: if request.auth != null;
    }

    match /complaints/{complaintId} {
      allow read, create: if request.auth != null;
    }
  }
}

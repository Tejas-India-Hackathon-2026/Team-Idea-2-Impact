{
  "name": "localkart-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan.bold,green.bold\" -n \"FRONTEND,BACKEND\" \"npm run frontend\" \"npm run backend\"",
    "frontend": "vite --port 3001",
    "backend": "node scripts/start-backend.cjs",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "description": "LocalKart - Hyperlocal E-Commerce Platform",
  "license": "ISC"
}
